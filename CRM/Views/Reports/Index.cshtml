<div class="content-wrapper">
    <!-- Animated Top Strip -->
    <div class="top-strip"></div>

    <!-- Content Header -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-left">
                        <li class="breadcrumb-item"><a href="#">Reports</a></li>
                        <li class="breadcrumb-item active">Transaction</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="content">
        <div class="container-fluid">

            <!-- Page Banner -->
            <div class="page-banner">
                <h2><i class="fa-solid fa-file-invoice-dollar" style="margin-right:10px;opacity:.7"></i>Transaction Report</h2>
                <p>Complete student fee transaction details with multi-column view</p>
                <div class="banner-icon"><i class="fa-solid fa-table-columns"></i></div>
            </div>

            <!-- Main Card -->
            <div class="card main-card">
                <div class="card-body">

                    <!-- ========== FILTERS ========== -->
                    <div class="filter-section">
                        <div class="filter-section-header">
                            <div class="filter-icon"><i class="fa-solid fa-filter"></i></div>
                            <h3>Filters</h3>
                            <div class="filter-divider"></div>
                        </div>

                        <!-- Row 1: Primary filters -->
                        <div class="filter-row">
                            <div class="filter-field wide">
                                <label for="ddlHead">Fee Head</label>
                                <select id="ddlHead" class="form-control">
                                    <option value="">All Heads</option>
                                    <option>Admission fees</option>
                                    <option>Identity card fees</option>
                                    <option>Tuition fees</option>
                                    <option>Annual function fees</option>
                                    <option>College development fees</option>
                                    <option>Activity fees</option>
                                    <option>University Exam. fees</option>
                                    <option>Bravery activity fees</option>
                                    <option>Departmental library fees</option>
                                    <option>Late fees</option>
                                    <option>Maintenance fees</option>
                                    <option>Establishment & college development fees</option>
                                    <option>Subject transfer fees</option>
                                    <option>Caution money</option>
                                    <option>Laboratory fees</option>
                                    <option>Transfer certificate fees</option>
                                    <option>College exam fees</option>
                                    <option>Medical fees</option>
                                    <option>Poor student fund</option>
                                    <option>Forwarding fees</option>
                                    <option>Enrollment Fees</option>
                                    <option>Eligibility Fees</option>
                                    <option>On line portal Fees</option>
                                    <option>Other fees</option>
                                </select>
                            </div>
                            <div class="filter-field">
                                <label for="ddlPaymentMode">Payment Mode</label>
                                <select id="ddlPaymentMode" class="form-control">
                                    <option value="">All Modes</option>
                                    <option>Cash</option>
                                    <option>Online</option>
                                    <option>Check</option>
                                </select>
                            </div>
                            <div class="filter-field">
                                <label for="txtReciptNo">Receipt No.</label>
                                <input id="txtReciptNo" class="form-control" type="search" placeholder="Search receipt..." aria-label="Search">
                            </div>
                            <div class="filter-field">
                                <label for="txtFromDate">From Date</label>
                                <div class="input-group date" id="reservationdate" data-target-input="nearest">
                                    <input id="txtFromDate" type="text" class="form-control datetimepicker-input" data-target="#reservationdate" placeholder="DD/MM/YYYY" />
                                    <div class="input-group-append" data-target="#reservationdate" data-toggle="datetimepicker">
                                        <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-field">
                                <label for="txtToDate">To Date</label>
                                <div class="input-group date" id="reservationEnddate" data-target-input="nearest">
                                    <input id="txtToDate" type="text" class="form-control datetimepicker-input" data-target="#reservationEnddate" placeholder="DD/MM/YYYY" />
                                    <div class="input-group-append" data-target="#reservationEnddate" data-toggle="datetimepicker">
                                        <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Row 2: Student/Class filters -->
                        <div class="filter-row">
                            <div class="filter-field">
                                <label for="txtSearch">Student Name</label>
                                <input id="txtSearch" class="form-control" type="search" placeholder="Search name..." aria-label="Search">
                            </div>
                            <div class="filter-field">
                                <label for="ddlSession">Session</label>
                                <select id="ddlSession" asp-items="Model.SessionList" class="form-control">
                                    <option value="">All Sessions</option>
                                </select>
                            </div>
                            <div class="filter-field">
                                <label for="ddlYear">Year</label>
                                <select id="ddlYear" asp-items="Model.YearList" class="form-control">
                                    <option value="">All Years</option>
                                </select>
                            </div>
                            <div class="filter-field">
                                <label for="ddlClass">Class</label>
                                <select id="ddlClass" asp-items="Model.ClassList" class="form-control">
                                    <option value="">All Classes</option>
                                </select>
                            </div>
                            <div class="filter-field">
                                <label for="ddlCourse">Course</label>
                                <select id="ddlCourse" asp-items="Model.SubjectList" class="form-control">
                                    <option value="">All Courses</option>
                                </select>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="filter-actions">
                            <button type="button" id="btnSearch" onclick="SearchStudent()" class="btn-search">
                                <i class="fas fa-search"></i> Search
                            </button>
                            <button type="reset" class="btn-reset" onclick="Reset()">
                                <i class="fas fa-rotate-right"></i> Reset
                            </button>
                            <form id="frmDownloadExcel" style="display:none;"></form>
                            <button type="submit" id="btnDownloadExcel" onclick="DownloadExcel()" class="btn-export">
                                <i class="fas fa-file-excel"></i> Export Excel
                            </button>
                        </div>
                    </div>

                    <!-- ========== STAT CARDS ========== -->
                    <div class="stats-row">
                        <div class="stat-card stat-primary">
                            <div class="stat-icon-box"><i class="fas fa-user-graduate"></i></div>
                            <div class="stat-body">
                                <div class="stat-label">Total Students</div>
                                <div id="spnTotalStudent" class="stat-value">0</div>
                            </div>
                        </div>
                        <div class="stat-card stat-emerald">
                            <div class="stat-icon-box"><i class="fas fa-indian-rupee-sign"></i></div>
                            <div class="stat-body">
                                <div class="stat-label">Total Amount</div>
                                <div id="spnAmount" class="stat-value">0</div>
                            </div>
                        </div>
                        <div class="stat-card stat-amber">
                            <div class="stat-icon-box"><i class="fas fa-layer-group"></i></div>
                            <div class="stat-body">
                                <div class="stat-label">Selected Head</div>
                                <div id="spnHead" class="stat-value" style="font-size:1rem;">All Heads</div>
                            </div>
                        </div>
                        <div class="stat-card stat-sky">
                            <div class="stat-icon-box"><i class="fas fa-calendar-days"></i></div>
                            <div class="stat-body">
                                <div class="stat-label">Date Range</div>
                                <div id="spnFromTo" class="stat-value" style="font-size:1rem;">All Dates</div>
                            </div>
                        </div>
                    </div>

                    <!-- ========== TABLE ========== -->
                    <div class="table-section">
                        <div class="table-section-header">
                            <div style="display:flex;align-items:center;">
                                <h3><i class="fa-solid fa-table-list"></i> Transaction Details</h3>
                                <span class="record-count" id="recordCount">0 records</span>
                                <span class="scroll-hint"><i class="fa-solid fa-arrows-left-right"></i> Scroll horizontally</span>
                            </div>
                        </div>

                        <div style="position:relative;">
                            <div id="Loader" class="overlay" style="display:none;position:absolute;inset:0;z-index:10;">
                                <i class="fas fa-2x fa-sync-alt fa-spin"></i>
                            </div>

                            <div class="table-scroll-wrapper">
                                <table id="tblStudentList" class="table table-bordered table-striped dataTable dtr-inline">
                                    <thead>
                                        <tr role="row">
                                            <th class="col-index">#</th>
                                            <th>Head</th>
                                            <th>Student Name</th>
                                            <th>Father Name</th>
                                            <th>Mobile No</th>
                                            <th>New/Old</th>
                                            <th>RegEx</th>
                                            <th>Session</th>
                                            <th>Year</th>
                                            <th>Class</th>
                                            <th>Course</th>
                                            <th>Admission Form No</th>
                                            <th>Create Date</th>
                                            <th>Created By</th>
                                            <th>Transaction No</th>
                                            <th>Payment Mode</th>
                                            <th class="col-amount">Amount</th>
                                            <th>Receipt No</th>
                                            <th>Receipt Book No</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </section>
</div>

@section Scripts {
    <script type="text/javascript">
        var BASE_URL = "@baseUrl";
        var studentTable;

        window.onload = function () {
            $('#reservationdate, #reservationEnddate').datetimepicker({
                format: 'DD/MM/YYYY'
            });
            SearchStudent();
        };

        function DownloadExcel() {
            $('form#frmDownloadExcel').submit();
        }

        function Reset() {
            // Reset all selects to empty value
            $('#ddlHead, #ddlPaymentMode, #ddlSession, #ddlYear, #ddlClass, #ddlCourse').val('');
            // Clear text inputs
            $("#txtReciptNo").val('');
            $("#txtFromDate").val('');
            $("#txtToDate").val('');
            $("#txtSearch").val('');
            SearchStudent();
        }

        function SearchStudent() {
            var varHad = $('#ddlHead').val();
            var varPaymentMode = $('#ddlPaymentMode').val();
            var varReciptNo = $("#txtReciptNo").val();
            var varFromDate = $("#txtFromDate").val();
            var varToDate = $("#txtToDate").val();
            var name = $("#txtSearch").val();
            var varSession = $('#ddlSession').val();
            var varYear = $('#ddlYear').val();
            var varClass = $('#ddlClass').val();
            var varCourse = $('#ddlCourse').val();
            $("#Loader").show();

            $.post(BASE_URL + "/Reports/GetStudentList", {
                had: varHad,
                paymentMode: varPaymentMode,
                reciptNo: varReciptNo,
                fromDate: varFromDate,
                toDate: varToDate,
                name: name,
                session: varSession,
                year: varYear,
                classes: varClass,
                course: varCourse
            },
            function (res) {
                TableData(res);
            });

            // Update stat card displays
            var headDisplay = varHad || 'All Heads';
            var dateDisplay = (varFromDate && varToDate) ? varFromDate + ' — ' + varToDate : 'All Dates';
            $("#spnHead").text(headDisplay);
            $("#spnFromTo").text(dateDisplay);
        }

        function formatPaymentMode(mode) {
            if (!mode) return '';
            var lower = mode.toLowerCase().trim();
            var cls = 'mode-cash';
            var icon = 'fa-money-bill-wave';
            if (lower === 'online') { cls = 'mode-online'; icon = 'fa-globe'; }
            else if (lower === 'check' || lower === 'cheque') { cls = 'mode-check'; icon = 'fa-money-check'; }
            return '<span class="badge-mode ' + cls + '"><i class="fas ' + icon + '" style="font-size:.65rem"></i> ' + mode + '</span>';
        }

        function formatNewOld(val) {
            if (!val) return '';
            var lower = val.toLowerCase().trim();
            if (lower === 'new') return '<span class="badge-newold is-new">New</span>';
            if (lower === 'old') return '<span-newold is-old">Old</span>';
            return val;
        }

        function TableData(tableData) {
            $("#tblStudentList tbody").empty();
            var varTotalStudent = 0;
            var varAmount = 0;

            if (tableData && tableData.data && tableData.data.length > 0) {
                $.each(tableData.data, function (index, element) {
                    varTotalStudent++;
                    var amt = parseFloat(element.amount) || 0;
                    varAmount += amt;

                    var rowHtml = '<tr>' +
                        '<td>' + varTotalStudent + '</td>' +
                        '<td>' + (element.head || '') + '</td>' +
                        '<td>' + (element.studentName || '') + '</td>' +
                        '<td>' + (element.fatherName || '') + '</td>' +
                        '<td>' + (element.mobileNoOne || '') + '</td>' +
                        '<td>' + formatNewOld(element.newOld) + '</td>' +
                        '<td>' + (element.regEx || '') + '</td>' +
                        '<td>' + (element.session || '') + '</td>' +
                        '<td>' + (element.year || '') + '</td>' +
                        '<td>' + (element.class || '') + '</td>' +
                        '<td>' + (element.course || '') + '</td>' +
                        '<td>' + (element.admissionFormNo || '') + '</td>' +
                        '<td>' + (element.createDateTime || '') + '</td>' +
                        '<td>' + (element.CreatedBy || '') + '</td>' +
                        '<td>' + (element.transactionNo || '') + '</td>' +
                        '<td>' + formatPaymentMode(element.paymentMode) + '</td>' +
                        '<td>' + amt.toLocaleString('en-IN') + '</td>' +
                        '<td>' + (element.recNumber || '') + '</td>' +
                        '<td>' + (element.recBookNo || '') + '</td>' +
                        '<td class="col-hidden">' + (element.studentId || '') + '</td>' +
                        '</tr>';

                    $("#tblStudentList").append(rowHtml);
                });
            } else {
                // Empty state
                $("#tblStudentList").append(
                    '<tr><td colspan="20" style="text-align:center;padding:50px 20px;color:var(--clr-text-faint);">' +
                    '<i class="fa-solid fa-inbox" style="font-size:2.2rem;display:block;margin-bottom:12px;color:#cbd5e1;"></i>' +
                    '<div style="font-size:.9rem;font-weight:500;">No transactions found</div>' +
                    '<div style="font-size:.78rem;margin-top:4px;">Try adjusting your filters and search again</div>' +
                    '</td></tr>'
                );
            }

            // Update stats
            $("#spnTotalStudent").text(varTotalStudent);
            $("#spnAmount").text(varAmount.toLocaleString('en-IN'));
            $("#recordCount").text(varTotalStudent + ' record' + (varTotalStudent !== 1 ? 's' : ''));

            $("#Loader").hide();
        }

        // Kept for compatibility
        function ExcelDownload() {
            var name = $("#txtSearch").val();
            var varClass = $('#ddlClass').val();
            var varSubject = $('#ddlSubject').val();
            var varCourse = $('#ddlCourse').val();
            var varRegPvt = $('#ddlRegPvt').val();

            $.post(BASE_URL + "/Student/DownloadExcel", {
                name: name,
                classes: varClass,
                subject: varSubject,
                course: varCourse,
                regPvt: varRegPvt
            },
            function (res) {
                TableData(res);
            });
        }
    </script>
}