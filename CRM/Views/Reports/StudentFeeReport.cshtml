            </div>

        </div>
    </section>
</div>

@section Scripts {
    <script type="text/javascript">
        var BASE_URL = "@baseUrl";

        /* ===== PAGINATION STATE ===== */
        var allData = [];          // All fetched records
        var currentPage = 1;       // Current page index
        var pageSize = 50;         // Records per page (default 50)

        /* ===== STATS STATE (computed from all data) ===== */
        var varTotalFee = 0;
        var varTotalPaid = 0;
        var varTotalDue = 0;

        window.onload = function () {
            SearchStudent();
        };

        function DownloadExcel() {
            $('form#frmDownloadExcel').submit();
        }

        function Reset() {
            $("#txtSearch").val('');
            $('#ddlSession, #ddlYear, #ddlClass, #ddlCourse').val('');
            SearchStudent();
        }

        function SearchStudent() {
            var name = $("#txtSearch").val();
            var varSession = $('#ddlSession').val();
            var varYear = $('#ddlYear').val();
            var varClass = $('#ddlClass').val();
            var varCourse = $('#ddlCourse').val();
            $("#Loader").show();

            $.post(BASE_URL + "/Reports/FeeReport", {
                name: name,
                session: varSession,
                year: varYear,
                classes: varClass,
                course: varCourse
            },
            function (res) {
                TableData(res);
            });
        }

        function TableData(tableData) {
            /* Reset pagination to page 1 on new search */
            currentPage = 1;
            allData = [];
            varTotalFee = 0;
            varTotalPaid = 0;
            varTotalDue = 0;

            if (tableData && tableData.data && tableData.data.length > 0) {
                /* Pre-compute stats from ALL data */
                $.each(tableData.data, function (index, element) {
                    var totalFee = parseFloat(element.totalFeeAfterDiscount) || 0;
                    var paid = parseFloat(element.paidAmount) || 0;
                    var remaining = totalFee - paid;

                    varTotalFee += totalFee;
                    varTotalPaid += paid;
                    varTotalDue += remaining;

                    allData.push({
                        studentName: element.studentName || '',
                        fatherName: element.fatherName || '',
                        mobileNoOne: element.mobileNoOne || '',
                        session: element.session || '',
                        year: element.year || '',
                        class: element.class || '',
                        course: element.course || '',
                        totalFee: totalFee,
                        paid: paid,
                        remaining: remaining,
                        discount: parseFloat(element.scholership) || 0,
                        scholershipBy: element.scholershipBy || '',
                        studentId: element.studentId || 0
                    });
                });
            }

            /* Update stat cards (always shows full dataset totals) */
            $("#spnTotalStudent").text(varTotalFee.toLocaleString('en-IN'));
            $("#spnAmount").text(varTotalPaid.toLocaleString('en-IN'));
            $("#spnDues").text(varTotalDue.toLocaleString('en-IN'));
            $("#spnFromTo").text(allData.length);
            $("#recordCount").text(allData.length + ' record' + (allData.length !== 1 ? 's' : ''));

            renderPage();
            $("#Loader").hide();
        }

        /* ===== RENDER CURRENT PAGE ROWS ===== */
        function renderPage() {
            $("#tblStudentList tbody").empty();

            if (allData.length === 0) {
                $("#tblStudentList").append(
                    '<tr><td colspan="14" style="text-align:center;padding:50px 20px;color:var(--clr-text-faint);">' +
                    '<i class="fa-solid fa-inbox" style="font-size:2.2rem;display:block;margin-bottom:12px;color:#cbd5e1;"></i>' +
                    '<div style="font-size:.9rem;font-weight:500;">No fee records found</div>' +
                    '<div style="font-size:.78rem;margin-top:4px;">Try adjusting your filters and search again</div>' +
                    '</td></tr>'
                );
                $("#paginationBar").hide();
                return;
            }

            var totalPages = Math.ceil(allData.length / pageSize);
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            var startIdx = (currentPage - 1) * pageSize;
            var endIdx = Math.min(startIdx + pageSize, allData.length);

            for (var i = startIdx; i < endIdx; i++) {
                var el = allData[i];
                var rowNum = i + 1;

                var rowClass = '';
                if (el.remaining <= 0) {
                    rowClass = ' class="row-zero-due"';
                } else if (el.totalFee > 0 && el.remaining > el.totalFee * 0.5) {
                    rowClass = ' class="row-high-due"';
                }

                var dueContent;
                if (el.remaining <= 0) {
                    dueContent = '<span class="badge-paid"><i class="fas fa-check" style="font-size:.6rem"></i> Clear</span>';
                } else {
                    dueContent = el.remaining.toLocaleString('en-IN');
                }

                var viewLink = '<a class="btn-view-history" href="../Student/PromodeStudent?id=' + el.studentId + '"><i class="fas fa-eye"></i> View</a>';

                $("#tblStudentList").append(
                    "<tr" + rowClass + ">" +
                    "<td>" + rowNum + "</td>" +
                    "<td>" + el.studentName + "</td>" +
                    "<td>" + el.fatherName + "</td>" +
                    "<td>" + el.mobileNoOne + "</td>" +
                    "<td>" + el.session + "</td>" +
                    "<td>" + el.year + "</td>" +
                    "<td>" + el.class + "</td>" +
                    "<td>" + el.course + "</td>" +
                    "<td>" + el.totalFee.toLocaleString('en-IN') + "</td>" +
                    "<td>" + el.paid.toLocaleString('en-IN') + "</td>" +
                    "<td>" + dueContent + "</td>" +
                    "<td>" + el.discount.toLocaleString('en-IN') + "</td>" +
                    "<td>" + el.scholershipBy + "</td>" +
                    "<td>" + viewLink + "</td>" +
                    "</tr>"
                );
            }

            renderPagination();
        }

        /* ===== RENDER PAGINATION CONTROLS ===== */
        function renderPagination() {
            var totalRecords = allData.length;
            var totalPages = Math.ceil(totalRecords / pageSize);

            if (totalPages <= 1) {
                $("#paginationBar").hide();
                return;
            }

            $("#paginationBar").show();

            var startIdx = (currentPage - 1) * pageSize + 1;
            var endIdx = Math.min(currentPage * pageSize, totalRecords);

            /* Info text */
            $("#paginationInfo").html(
                'Showing <strong>' + startIdx + '</strong> to <strong>' + endIdx + '</strong> of <strong>' + totalRecords + '</strong> records'
            );

            /* Page buttons */
            var html = '';

            /* Prev button */
            html += '<button ' + (currentPage <= 1 ? 'disabled' : 'onclick="goToPage(' + (currentPage - 1) + ')"') + '><i class="fas fa-chevron-left" style="font-size:.7rem"></i></button>';

            /* Calculate visible page range (max 7 buttons) */
            var maxVisible = 7;
            var startPage, endPage;

            if (totalPages <= maxVisible) {
                startPage = 1;
                endPage = totalPages;
            } else {
                var half = Math.floor(maxVisible / 2);
                startPage = currentPage - half;
                endPage = currentPage + half;

                if (startPage < 1) {
                    startPage = 1;
                    endPage = maxVisible;
                } else if (endPage > totalPages) {
                    endPage = totalPages;
                    startPage = totalPages - maxVisible + 1;
                }
            }

            /* First page + ellipsis */
            if (startPage > 1) {
                html += '<button onclick="goToPage(1)">1</button>';
                if (startPage > 2) {
                    html += '<button class="ellipsis-btn" disabled>...</button>';
                }
            }

            /* Page number buttons */
            for (var p = startPage; p <= endPage; p++) {
                if (p === currentPage) {
                    html += '<button class="active-page">' + p + '</button>';
                } else {
                    html += '<button onclick="goToPage(' + p + ')">' + p + '</button>';
                }
            }

            /* Last page + ellipsis */
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    html += '<button class="ellipsis-btn" disabled>...</button>';
                }
                html += '<button onclick="goToPage(' + totalPages + ')">' + totalPages + '</button>';
            }

            /* Next button */
            html += '<button ' + (currentPage >= totalPages ? 'disabled' : 'onclick="goToPage(' + (currentPage + 1) + ')"') + '><i class="fas fa-chevron-right" style="font-size:.7rem"></i></button>';

            $("#paginationControls").html(html);
        }

        /* ===== NAVIGATE TO PAGE ===== */
        function goToPage(page) {
            var totalPages = Math.ceil(allData.length / pageSize);
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderPage();
            /* Scroll table into view smoothly */
            $(".table-wrapper")[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        /* ===== CHANGE PAGE SIZE ===== */
        function changePageSize() {
            pageSize = parseInt($("#ddlPageSize").val()) || 50;
            currentPage = 1;
            renderPage();
        }

        /* ============================================
           PRINT REPORT — opens a clean print window
           with ALL data (not just current page)
           ============================================ */
        function printReport() {
            if (allData.length === 0) {
                alert('No data to print. Please search first.');
                return;
            }

            /* Gather applied filter labels */
            var filterName = $("#txtSearch").val() || 'All';
            var filterSession = $('#ddlSession option:selected').text() || 'All Sessions';
            var filterYear = $('#ddlYear option:selected').text() || 'All Years';
            var filterClass = $('#ddlClass option:selected').text() || 'All Classes';
            var filterCourse = $('#ddlCourse option:selected').text() || 'All Courses';
            var printDate = new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
            var printTime = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });

            /* Build table rows */
            var rowsHtml = '';
            for (var i = 0; i < allData.length; i++) {
                var el = allData[i];
                var dueText = el.remaining <= 0 ? 'Clear' : el.remaining.toLocaleString('en-IN');
                rowsHtml +=
                    '<tr>' +
                    '<td style="text-align:center;font-weight:700;color:#4f46e5;">' + (i + 1) + '</td>' +
                    '<td style="font-weight:600;">' + el.studentName + '</td>' +
                    '<td>' + el.fatherName + '</td>' +
                    '<td>' + el.mobileNoOne + '</td>' +
                    '<td>' + el.session + '</td>' +
                    '<td>' + el.year + '</td>' +
                    '<td>' + el.class + '</td>' +
                    '<td>' + el.course + '</td>' +
                    '<td style="font-weight:700;text-align:right;">' + el.totalFee.toLocaleString('en-IN') + '</td>' +
                    '<td style="font-weight:700;text-align:right;color:#059669;">' + el.paid.toLocaleString('en-IN') + '</td>' +
                    '<td style="font-weight:700;text-align:right;color:' + (el.remaining <= 0 ? '#059669' : '#e11d48') + ';">' + dueText + '</td>' +
                    '<td style="text-align:right;color:#d97706;">' + el.discount.toLocaleString('en-IN') + '</td>' +
                    '<td>' + el.scholershipBy + '</td>' +
                    '</tr>';
            }

            /* Footer totals row */
            rowsHtml +=
                '<tr style="background:#f1f5f9;font-weight:800;border-top:2px solid #334155;">' +
                '<td colspan="8" style="text-align:right;padding-right:14px;font-size:.85rem;">GRAND TOTAL</td>' +
                '<td style="text-align:right;">' + varTotalFee.toLocaleString('en-IN') + '</td>' +
                '<td style="text-align:right;color:#059669;">' + varTotalPaid.toLocaleString('en-IN') + '</td>' +
                '<td style="text-align:right;color:#e11d48;">' + varTotalDue.toLocaleString('en-IN') + '</td>' +
                '<td style="text-align:right;color:#d97706;">' + allData.reduce(function(s, e) { return s + e.discount; }, 0).toLocaleString('en-IN') + '</td>' +
                '<td></td>' +
                '</tr>';

            var printHtml = '<!DOCTYPE html>' +
                '<html><head><title>Student Fee Report - Print</title>' +
                '<style>' +
                '* { margin: 0; padding: 0; box-sizing: border-box; }' +
                'body { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; font-size: 11px; color: #1e293b; padding: 20px; }' +
                '@@page { size: A4 landscape; margin: 12mm 10mm; }' +
                '.print-header { text-align: center; margin-bottom: 14px; border-bottom: 2px solid #334155; padding-bottom: 12px; }' +
                '.print-header h1 { font-size: 18px; font-weight: 800; color: #1e293b; margin-bottom: 2px; }' +
                '.print-header p { font-size: 10px; color: #64748b; }' +
                '.print-stats { display: flex; gap: 12px; margin-bottom: 14px; }' +
                '.print-stat-box { flex: 1; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 12px; text-align: center; }' +
                '.print-stat-box .label { font-size: 8px; text-transform: uppercase; letter-spacing: .08em; color: #64748b; font-weight: 700; }' +
                '.print-stat-box .value { font-size: 14px; font-weight: 800; color: #1e293b; margin-top: 2px; }' +
                '.print-filters { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-bottom: 12px; font-size: 10px; color: #475569; }' +
                '.print-filters span { font-weight: 600; }' +
                '.print-filters strong { color: #1e293b; }' +
                'table { width: 100%; border-collapse: collapse; font-size: 10px; }' +
                'thead tr { background: #334155 !important; }' +
                'th { color: #fff; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 7px 8px; text-align: left; white-space: nowrap; }' +
                'td { padding: 5px 8px; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }' +
                'tbody tr:nth-child(even) { background: #f8fafc; }' +
                '.print-footer { margin-top: 14px; padding-top: 8px; border-top: 1px solid #cbd5e1; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }' +
                '@@media print { body { padding: 0; } .no-print { display: none !important; } }' +
                '</style></head><body>' +

                /* Header */
                '<div class="print-header">' +
                '<h1><i class="fa-solid fa-indian-rupee-sign" style="margin-right:6px;"></i>Student Fee Report</h1>' +
                '<p>Generated on ' + printDate + ' at ' + printTime + ' &mdash; Total ' + allData.length + ' student(s)</p>' +
                '</div>' +

                /* Stats */
                '<div class="print-stats">' +
                '<div class="print-stat-box"><div class="label">Total Fee</div><div class="value">' + varTotalFee.toLocaleString('en-IN') + '</div></div>' +
                '<div class="print-stat-box"><div class="label">Total Paid</div><div class="value" style="color:#059669;">' + varTotalPaid.toLocaleString('en-IN') + '</div></div>' +
                '<div class="print-stat-box"><div class="label">Total Dues</div><div class="value" style="color:#e11d48;">' + varTotalDue.toLocaleString('en-IN') + '</div></div>' +
                '<div class="print-stat-box"><div class="label">Students</div><div class="value">' + allData.length + '</div></div>' +
                '</div>' +

                /* Filters applied */
                '<div class="print-filters">' +
                '<span>Name: <strong>' + filterName + '</strong></span>' +
                '<span>Session: <strong>' + filterSession + '</strong></span>' +
                '<span>Year: <strong>' + filterYear + '</strong></span>' +
                '<span>Class: <strong>' + filterClass + '</strong></span>' +
                '<span>Course: <strong>' + filterCourse + '</strong></span>' +
                '</div>' +

                /* Table */
                '<table>' +
                '<thead><tr>' +
                '<th style="text-align:center;width:35px;">#</th>' +
                '<th>Student Name</th>' +
                '<th>Father Name</th>' +
                '<th>Mobile No</th>' +
                '<th>Session</th>' +
                '<th>Year</th>' +
                '<th>Class</th>' +
                '<th>Course</th>' +
                '<th style="text-align:right;">Total Fee</th>' +
                '<th style="text-align:right;">Paid</th>' +
                '<th style="text-align:right;">Due</th>' +
                '<th style="text-align:right;">Discount</th>' +
                '<th>Discount By</th>' +
                '</tr></thead>' +
                '<tbody>' + rowsHtml + '</tbody>' +
                '</table>' +

                /* Footer */
                '<div class="print-footer">' +
                '<span>Student Fee Report &mdash; Confidential</span>' +
                '<span>Page printed on ' + printDate + '</span>' +
                '</div>' +

                /* Auto print script */
                '<script>setTimeout(function(){window.print();},400);<\/script>' +
                '</body></html>';

            var printWin = window.open('', '_blank', 'width=1100,height=750,scrollbars=yes');
            printWin.document.write(printHtml);
            printWin.document.close();
        }

        /* Kept for compatibility */
        function ExcelDownload() {
            var name = $("#txtSearch").val();
            var varClass = $('#ddlClass').val();
            var varSubject = $('#ddlSubject').val();
            var varCourse = $('#ddlCourse').val();
            var varRegPvt = $('#ddlRegPvt').val();

            $.post(BASE_URL + "/Student/DownloadExcel", {
                name: name,
                classes: varClass,
                subject: varSubject,
                course: varCourse,
                regPvt: varRegPvt
            },
            function (res) {
                TableData(res);
            });
        }
    </script>
