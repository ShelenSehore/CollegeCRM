</div>

@section Scripts {
    <script type="text/javascript">
        var BASE_URL = "@baseUrl";
        var studentTable;

        window.onload = function () {
            $('#reservationdate, #reservationEnddate').datetimepicker({
                format: 'DD/MM/YYYY'
            });
            SearchStudent();
            $('#ddlHead, #ddlPaymentMode, #ddlSession, #ddlYear, #ddlClass, #ddlCourse').each(function () {
                SearchStudent();
            });

        };

        // ===== Toggle Advanced Filters =====
        function toggleAdvanced() {
            var panel = document.getElementById('advancedFilters');
            var btn = document.getElementById('btnToggleAdvanced');
            panel.classList.toggle('show');
            if (panel.classList.contains('show')) {
                btn.innerHTML = '<i class="fa-solid fa-sliders"></i> Less Filters';
                btn.style.background = 'var(--clr-primary-soft)';
                btn.style.color = 'var(--clr-primary)';
                btn.style.borderColor = 'rgba(79,70,229,.25)';
            } else {
                btn.innerHTML = '<i class="fa-solid fa-sliders"></i> More Filters';
                btn.style.background = '';
                btn.style.color = '';
                btn.style.borderColor = '';
            }
        }

        function DownloadExcel() {
            $('form#frmDownloadExcel').submit();
        }

        function Reset() {
            $('#ddlHead, #ddlPaymentMode, #ddlSession, #ddlYear, #ddlClass, #ddlCourse').each(function () {
                $(this).val('');
            });
            $("#txtReciptNo").val('');
            $("#txtFromDate").val('');
            $("#txtToDate").val('');
            $("#txtSearch").val('');
            SearchStudent();
        }

        function SearchStudent() {
            var varHad = $('#ddlHead').val();
            var varPaymentMode = $('#ddlPaymentMode').val();
            var varReciptNo = $("#txtReciptNo").val();
            var varFromDate = $("#txtFromDate").val();
            var varToDate = $("#txtToDate").val();
            var name = $("#txtSearch").val();
            var varSession = $('#ddlSession').val();
            var varYear = $('#ddlYear').val();
            var varClass = $('#ddlClass').val();
            var varCourse = $('#ddlCourse').val();
            $("#Loader").show();

            $.post(BASE_URL + "/Reports/GetDfcList", {
                had: varHad,
                paymentMode: varPaymentMode,
                reciptNo: varReciptNo,
                fromDate: varFromDate,
                toDate: varToDate,
                name: name,
                session: varSession,
                year: varYear,
                classes: varClass,
                course: varCourse
            },
                function (res) {
                    TableData(res);
                }
            );

            // Update stat cards
            var headDisplay = varHad || 'All Heads';
            var dateDisplay = (varFromDate && varToDate) ? varFromDate + ' - ' + varToDate : 'All Dates';
            $("#spnHead").text(headDisplay);
            $("#spnFromTo").text(dateDisplay);
        }

        // ===================================================================
        //  FORMAT HELPER — Indian number formatting
        // ===================================================================
        function fmt(amount) {
            return amount.toLocaleString('en-IN');
        }

        // ===================================================================
        //  DATE PARSER — Converts DD/MM/YYYY (or DD/MM/YYYY HH:mm) to
        //  YYYY-MM-DD for correct chronological sorting
        // ===================================================================
        function toSortableDate(displayDate) {
            if (!displayDate) return '';
            var datePart = displayDate.split(' ')[0];
            var parts = datePart.split('/');
            if (parts.length === 3) {
                return parts[2].padStart(4, '0') + '-' + parts[1].padStart(2, '0') + '-' + parts[0].padStart(2, '0');
            }
            return displayDate;
        }

        // ===================================================================
        //  ROW BUILDER HELPERS
        // ===================================================================
        function addDataRow(idx, date, head, cls, cur, yer, student, father, amount) {
            $("#tblStudentList").append(
                '<tr>' +
                '<td>' + idx + '</td>' +
                '<td>' + date + '</td>' +
                '<td>' + head + '</td>' +
                '<td>' + cls + '</td>' +
                '<td>' + cur + '</td>' +
                '<td>' + yer + '</td>' +
                '<td>' + student + '</td>' +
                '<td>' + father + '</td>' +
                '<td>' + fmt(amount) + '</td>' +
                '</tr>'
            );
        }

        function addHeadSubtotal(idx, headName, total) {
            $("#tblStudentList").append(
                '<tr class="HeadSubtotalRow">' +
                '<td>' + idx + '</td>' +
                '<td></td>' +
                '<td><i class="fa-solid fa-angle-right" style="margin-right:6px;opacity:.45"></i>' + headName + ' Subtotal</td>' +
                '<td></td>' +
                '<td></td>' +
                '<td></td>' +
                '<td>' + fmt(total) + '</td>' +
                '</tr>'
            );
        }

        function addDateSubtotal(idx, dateStr, total) {
            $("#tblStudentList").append(
                '<tr class="DateSubtotalRow">' +
                '<td>' + idx + '</td>' +
                '<td><i class="fa-solid fa-calendar-day" style="margin-right:6px;opacity:.55"></i>Date Total: ' + dateStr + '</td>' +
                '<td></td>' +
                '<td></td>' +
                '<td></td>' +
                '<td></td>' +
                '<td>' + fmt(total) + '</td>' +
                '</tr>'
            );
        }

        function addGrandTotal(idx, total) {
            $("#tblStudentList").append(
                '<tr class="GrandTotalRow">' +
                '<td>' + idx + '</td>' +
                '<td colspan="5"><i class="fa-solid fa-calculator" style="margin-right:8px;opacity:.7"></i>GRAND TOTAL</td>' +
                '<td>' + fmt(total) + '</td>' +
                '</tr>'
            );
        }

        function addHeadSummaryHeader() {
            $("#tblStudentList").append(
                '<tr class="HeadSummaryHeader"><td colspan="7">' +
                '<i class="fa-solid fa-layer-group" style="margin-right:8px"></i>HEAD-WISE SUMMARY</td></tr>'
            );
        }

        function addHeadSummaryRow(idx, headName, total) {
            $("#tblStudentList").append(
                '<tr class="HeadSummaryRow">' +
                '<td>' + idx + '</td>' +
                '<td></td>' +
                '<td>' + headName + '</td>' +
                '<td></td>' +
                '<td></td>' +
                '<td></td>' +
                '<td>' + fmt(total) + '</td>' +
                '</tr>'
            );
        }

        function addHeadSummaryTotal(idx, total) {
            $("#tblStudentList").append(
                '<tr class="HeadWiseTotalRow">' +
                '<td>' + idx + '</td>' +
                '<td colspan="5"><i class="fa-solid fa-list-check" style="margin-right:8px;opacity:.7"></i>HEAD-WISE TOTAL</td>' +
                '<td>' + fmt(total) + '</td>' +
                '</tr>'
            );
        }

        function appendEmptyState() {
            $("#tblStudentList").append(
                '<tr><td colspan="7" style="text-align:center;padding:40px 20px;color:var(--clr-text-faint);">' +
                '<i class="fa-solid fa-inbox" style="font-size:2rem;display:block;margin-bottom:10px;color:#cbd5e1;"></i>' +
                '<div style="font-size:.9rem;font-weight:500;">No transactions found</div>' +
                '<div style="font-size:.78rem;margin-top:4px;">Try adjusting your filters and search again</div>' +
                '</td></tr>'
            );
        }

        function updateStats(count, total) {
            $("#spnTotalStudent").text(count);
            $("#spnAmount").text(fmt(total));
            $("#recordCount").text(count + ' record' + (count !== 1 ? 's' : ''));
        }

        // ===================================================================
        //  MAIN TABLE BUILDER — Groups by Date → Head, inserts subtotals
        // ===================================================================
        function TableData(tableData) {
            $("#tblStudentList tbody").empty();

            var grandTotal = 0;
            var actualCount = 0;
            var displayIndex = 0;

            if (tableData && tableData.data && tableData.data.length > 0) {

                // Exclude any server-side total rows
                var data = tableData.data.filter(function (el) {
                    return !(el.head === 'Total' || el.head === 'total');
                });

                if (data.length === 0) {
                    appendEmptyState();
                    updateStats(0, 0);
                    $("#Loader").hide();
                    return;
                }

                actualCount = data.length;

                // Sort by date (chronological), then by head name (alphabetical)
                data.sort(function (a, b) {
                    var dA = toSortableDate(a.createDateTimeDisplay);
                    var dB = toSortableDate(b.createDateTimeDisplay);
                    if (dA < dB) return -1;
                    if (dA > dB) return 1;
                    return (a.head || '').localeCompare(b.head || '');
                });

                var prevDate = null;   // Date-only part for grouping (DD/MM/YYYY)
                var prevHead = null;
                var dateSum = 0;
                var headSum = 0;
                var headTotals = {};   // Accumulator for head-wise summary at bottom

                for (var i = 0; i < data.length; i++) {
                    var item = data[i];
                    var amt = parseFloat(item.amount) || 0;
                    var dtFull = item.createDateTimeDisplay || '';      // Full datetime for display
                    var dt = dtFull.split(' ')[0];                      // Date only for grouping
                    var hd = item.head || '';

                    // Accumulate head-wise total for summary section
                    headTotals[hd] = (headTotals[hd] || 0) + amt;

                    // --- Head changed within the SAME date → insert head subtotal ---
                    if (prevDate === dt && prevHead !== null && prevHead !== hd) {
                        displayIndex++;
                        addHeadSubtotal(displayIndex, prevHead, headSum);
                        headSum = 0;
                    }

                    // --- Date changed → flush remaining head subtotal + date subtotal ---
                    if (prevDate !== null && prevDate !== dt) {
                        if (headSum > 0) {
                            displayIndex++;
                            addHeadSubtotal(displayIndex, prevHead, headSum);
                            headSum = 0;
                        }
                        displayIndex++;
                        addDateSubtotal(displayIndex, prevDate, dateSum);
                        dateSum = 0;
                    }

                    // --- Regular data row ---
                    displayIndex++;
                    
                    addDataRow(displayIndex, dtFull, hd, item.class, item.course, item.year  || '', item.studentName || '', item.fatherName || '', amt);

                    grandTotal += amt;
                    dateSum += amt;
                    headSum += amt;

                    prevDate = dt;
                    prevHead = hd;
                }

                // --- Flush last head subtotal ---
                if (headSum > 0 && prevHead) {
                    displayIndex++;
                    addHeadSubtotal(displayIndex, prevHead, headSum);
                }

                // --- Flush last date subtotal ---
                if (dateSum > 0 && prevDate) {
                    displayIndex++;
                    addDateSubtotal(displayIndex, prevDate, dateSum);
                }

                // --- Grand Total ---
                displayIndex++;
                addGrandTotal(displayIndex, grandTotal);

                // --- Head-wise Summary Section ---
                addHeadSummaryHeader();

                var sortedHeads = Object.keys(headTotals).sort();
                var headSummaryTotal = 0;
                for (var j = 0; j < sortedHeads.length; j++) {
                    displayIndex++;
                    var hAmt = headTotals[sortedHeads[j]];
                    headSummaryTotal += hAmt;
                    addHeadSummaryRow(displayIndex, sortedHeads[j], hAmt);
                }

                displayIndex++;
                addHeadSummaryTotal(displayIndex, headSummaryTotal);

            } else {
                appendEmptyState();
            }

            updateStats(actualCount, grandTotal);
            $("#Loader").hide();
        }

        // Unused function kept for compatibility
        function ExcelDownload() {
            var name = $("#txtSearch").val();
            var varClass = $('#ddlClass').val();
            var varSubject = $('#ddlSubject').val();
            var varCourse = $('#ddlCourse').val();
            var varRegPvt = $('#ddlRegPvt').val();

            $.post(BASE_URL + "/Student/DownloadExcel", {
                name: name,
                classes: varClass,
                subject: varSubject,
                course: varCourse,
                regPvt: varRegPvt
            },
                function (res) {
                    TableData(res);
                }
            );
        }
    </script>
}}