@section Scripts {
    <script>
        // ========== TAB NAVIGATION ==========
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabPanes = document.querySelectorAll('.tab-pane');
        const btnPrev = document.getElementById('btnPrev');
        const btnNext = document.getElementById('btnNext');
        const btnReset = document.getElementById('btnReset');
        const currentStepEl = document.getElementById('currentStep');
        const totalStepsEl = document.getElementById('totalSteps');
        const totalSteps = tabBtns.length;

        totalStepsEl.textContent = totalSteps;
        let activeIndex = 0;

        function switchTab(index) {
            // Clamp index
            if (index < 0) return;
            if (index >= totalSteps) return;

            activeIndex = index;
            currentStepEl.textContent = index + 1;

            // Update buttons
            tabBtns.forEach((btn, i) => {
                btn.classList.toggle('active', i === index);
                btn.setAttribute('aria-selected', i === index ? 'true' : 'false');
            });

            tabPanes.forEach((pane, i) => {
                pane.classList.toggle('active', i === index);
            });

            // Prev/Next states
            btnPrev.disabled = (index === 0);
            if (index === totalSteps - 1) {
                btnNext.style.display = 'none';
            } else {
                btnNext.style.display = 'inline-flex';
            }

            // Scroll tab button into view on mobile
            tabBtns[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        tabBtns.forEach((btn, i) => {
            btn.addEventListener('click', () => switchTab(i));
        });

        btnNext.addEventListener('click', () => {
            if (activeIndex < totalSteps - 1) switchTab(activeIndex + 1);
        });

        btnPrev.addEventListener('click', () => {
            if (activeIndex > 0) switchTab(activeIndex - 1);
        });

        // Keyboard navigation between tabs
        document.addEventListener('keydown', (e) => {
            // Only if no input/textarea/select is focused
            const tag = document.activeElement.tagName;
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

            if (e.key === 'ArrowRight' && activeIndex < totalSteps - 1) {
                e.preventDefault();
                switchTab(activeIndex + 1);
            } else if (e.key === 'ArrowLeft' && activeIndex > 0) {
                e.preventDefault();
                switchTab(activeIndex - 1);
            }
        });

        // Initialize
        switchTab(0);

        // ========== TAB COMPLETION TRACKING ==========
        function checkTabCompletion(tabId) {
            const pane = document.getElementById('tab-' + tabId);
            if (!pane) return false;
            const inputs = pane.querySelectorAll('input, select, textarea');
            let filled = 0;
            let total = 0;
            inputs.forEach(inp => {
                if (inp.type === 'file') return;
                if (inp.name === '__RequestVerificationToken') return;
                total++;
                if (inp.value && inp.value.trim() !== '') filled++;
            });
            return total > 0 && filled >= Math.ceil(total * 0.5);
        }

        function updateTabChecks() {
            tabBtns.forEach((btn, i) => {
                const tabId = btn.dataset.tab;
                if (checkTabCompletion(tabId)) {
                    btn.classList.add('completed');
                } else {
                    btn.classList.remove('completed');
                }
            });
        }

        // Listen for input changes across all tabs
        document.getElementById('employeeForm').addEventListener('input', updateTabChecks);
        document.getElementById('employeeForm').addEventListener('change', updateTabChecks);

        // ========== PHOTO PREVIEW ==========
        const photoInput = document.getElementById('PhotoFile');
        const photoPreview = document.getElementById('photoPreview');
        const photoArea = document.getElementById('photoUploadArea');

        if (photoInput) {
            photoInput.addEventListener('change', function () {
                if (this.files && this.files[0]) {
                    const file = this.files[0];
                    // Validate size (2MB)
                    if (file.size > 2 * 1024 * 1024) {
                        alert('Photo size must be less than 2MB.');
                        this.value = '';
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        photoPreview.src = e.target.result;
                        photoArea.classList.add('has-file');
                    };
                    reader.readAsDataURL(file);
                } else {
                    photoPreview.src = '';
                    photoArea.classList.remove('has-file');
                }
            });
        }

        // ========== RESET FORM ==========
        btnReset.addEventListener('click', function () {
            if (confirm('Are you sure you want to reset the form? All entered data will be lost.')) {
                document.getElementById('employeeForm').reset();
                photoPreview.src = '';
                photoArea.classList.remove('has-file');
                // Clear validation states
                document.querySelectorAll('.input-validation-error').forEach(el => {
                    el.classList.remove('input-validation-error');
                });
                document.querySelectorAll('.field-validation-error').forEach(el => {
                    el.textContent = '';
                });
                document.querySelectorAll('.validation-summary-errors').forEach(el => {
                    el.style.display = 'none';
                });
                switchTab(0);
                updateTabChecks();
            }
        });

        // ========== AADHAR FORMATTING ==========
        const aadharInput = document.querySelector('input[name="AadharNo"]');
        if (aadharInput) {
            aadharInput.addEventListener('input', function () {
                let val = this.value.replace(/\D/g, '').substring(0, 12);
                if (val.length > 4) val = val.substring(0, 4) + ' ' + val.substring(4);
                if (val.length > 9) val = val.substring(0, 9) + ' ' + val.substring(9);
                this.value = val;
            });
        }

        // ========== SUBMIT — VALIDATE ALL TABS VISUALLY ==========
        document.getElementById('employeeForm').addEventListener('submit', function () {
            // Show all tab panes briefly for server-side validation to render errors
            // The form will post normally; if validation fails, errors appear
            updateTabChecks();
        });

        // If there are validation errors on load, find the first error tab and switch to it
        (function () {
            const errors = document.querySelectorAll('.input-validation-error, .field-validation-error:not(:empty)');
            if (errors.length > 0) {
                const firstError = errors[0];
                const pane = firstError.closest('.tab-pane');
                if (pane) {
                    const tabId = pane.id.replace('tab-', '');
                    const idx = Array.from(tabBtns).findIndex(b => b.dataset.tab === tabId);
                    if (idx >= 0) switchTab(idx);
                }
            }
        })();

        // Initial check
        updateTabChecks();
    </script>
}